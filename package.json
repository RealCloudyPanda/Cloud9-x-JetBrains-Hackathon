{
  "name": "ghost-relay",
  "private": true,
  "version": "0.1.0",
  "description": "A 30-second neon sprint where you race the ghost of the player who went right before you.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "booth": "vite build && vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "house-ghost": "vite-node scripts/make-house-ghost.ts"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-node": "^5.0.0",
    "vitest": "^5.0.0"
  }
}
